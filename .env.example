# CONFIGURACIÓN DE VARIABLES DE ENTORNO (TEMPLATE)
# Duplica este archivo como .env y ajusta las variables según tu entorno.

# URL base del Servidor API Backend
VITE_API_URL=https://dashboard.servidor.blog/api/client-portal

# URL base para la conexión de WebSockets (Socket.io)
VITE_SOCKET_URL=https://dashboard.servidor.blog

# Llave de API para autenticación administrativa
VITE_ADMIN_KEY=tu_llave_secreta_administrador_aqui

# Número de WhatsApp de atención al cliente (formato internacional sin signo +)
VITE_SUPPORT_PHONE=573137374108
